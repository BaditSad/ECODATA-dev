# ── Supabase ────────────────────────────────────────────────────────────────
# Browser-safe: anon key is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS: never expose to the browser, never prefix NEXT_PUBLIC_.
# Used by the telemetry ingestion route and the super-admin data layer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Guest / lobby sessions ──────────────────────────────────────────────────
# HMAC-SHA256 secret signing the stateless guest & lobby session cookies.
# Generate with: openssl rand -base64 48
GUEST_SESSION_SECRET=replace-me-with-at-least-32-characters-of-entropy

# ── Sensor fleet ────────────────────────────────────────────────────────────
# Pepper mixed into sensor API key hashes. Rotating this invalidates every
# provisioned balise, so treat it as a break-glass operation.
SENSOR_API_KEY_PEPPER=replace-me-with-at-least-32-characters-of-entropy

# ── Platform ────────────────────────────────────────────────────────────────
# Sole super-admin identity allowed into /admin.
SUPER_ADMIN_EMAIL=brieuc@ecodatalink.com
